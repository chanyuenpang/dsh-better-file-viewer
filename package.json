{
  "name": "dsh-better-file-viewer",
  "version": "0.1.11",
  "description": "Independent Files session view with tree and Miller-column navigation, image galleries, official preview forks, and default super-json-editor styling",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client*.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "LICENSE", "THIRD_PARTY_NOTICES.md", "THIRD_PARTY_LICENSES.txt", "README.md"],
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test tests/*.test.mjs", "vendor": "node scripts/fetch-vendor.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-resources", "@deepseek-ai/dsh-api-workspace-files", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-file-drag", "@deepseek-ai/dsh-client-ui-context-menu", "@deepseek-ai/dsh-client-ui-settings"] } },
  "devDependencies": {
    "esbuild": "0.25.12", "postcss": "8.5.6", "postcss-selector-parser": "7.1.0",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.1", "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.1",
    "react": "18.3.1", "react-dom": "18.3.1", "clsx": "2.1.1", "zustand": "5.0.8", "immer": "10.1.3",
    "shiki": "4.4.3", "@shikijs/langs": "4.4.3", "simple-icons": "16.31.0", "katex": "0.18.7", "anser": "2.3.5", "diff": "9.0.0",
    "mdast-util-from-markdown": "2.0.3", "mdast-util-gfm": "3.1.0", "mdast-util-math": "3.0.0", "micromark-extension-gfm": "3.0.0", "micromark-extension-math": "3.1.0", "micromark-core-commonmark": "2.0.3", "micromark-util-character": "2.1.1", "micromark-util-classify-character": "2.0.1", "micromark-util-symbol": "2.0.1", "micromark-factory-space": "2.0.1", "micromark-util-decode-string": "2.0.1", "micromark-util-sanitize-uri": "2.0.1",
    "@radix-ui/react-dialog": "1.1.15", "@radix-ui/react-popover": "1.1.15", "@radix-ui/react-tooltip": "1.2.8", "@tabler/icons-react": "3.44.0", "@tanstack/react-table": "8.21.3"
  }
}
